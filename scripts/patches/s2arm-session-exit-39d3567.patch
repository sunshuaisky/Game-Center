+int s2a_ios_resume_game(const char *gid) {
+    if (!NSThread.isMainThread || s2a_host_session_state() != S2A_SESSION_STOPPED) return -1;
+    const s2a_launch_ctx *lc = s2a_launch_ctx_get();
+    if (!lc || !gid) return -4;
+    {
+        const char *why = s2a_launch_ctx_select(gid);
+        if (why) { LOG("Game Center：切换游戏失败：%s", why); return -4; }
+        int s2a_host_select_stopped_game(void);
+        if (s2a_host_select_stopped_game()) return -5;
+        LOG("Game Center：切换游戏 %s，%s", gid, s2a_host_pre_ui_checks());
+        int (*graphics)(void) = (int (*)(void))dlsym(RTLD_DEFAULT, "s2a_direct_game_switch");
+        if (graphics && graphics()) return -6;
+        [NSUserDefaults.standardUserDefaults setObject:@(gid) forKey:@"S2ALastGameId"];
+    }
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene.delegate isKindOfClass:S2ASceneDelegate.class]) continue;
+        S2ASceneDelegate *sd = (S2ASceneDelegate *)scene.delegate;
+        UIViewController *previous = sd.window.rootViewController;
+        [sd enterGame];
+        [sd prepareGameView];
+        int result = s2a_host_resume(gamecenter_resume_done, NULL);
+        if (result) { sd.window.rootViewController = previous; g_root = nil; }
+        return result;
+    }
+    return -2;
+}
